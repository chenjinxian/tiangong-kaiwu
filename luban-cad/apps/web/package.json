{
  "name": "@open-cloud-cad/web",
  "version": "1.0.0",
  "description": "Open Cloud CAD Web Application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\" 1>&2",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "start": "run-p start:frontend start:backend",
    "start:frontend": "cross-env NODE_ENV=development vite",
    "start:backend": "cd ../backend && npm run dev",
    "start:all": "npm run build:deps && run-p start:frontend start:backend",
    "build:deps": "cd ../../../itwinjs-core && node common/scripts/install-run-rush.js build --to @itwin/core-backend --to @itwin/core-frontend --to @itwin/editor-backend --to @itwin/editor-frontend --to @itwin/presentation-frontend --to @itwin/presentation-common --to @itwin/appui-abstract --to @itwin/ecschema-metadata --to @itwin/ecschema-rpcinterface-common --to @itwin/core-i18n --to @itwin/core-quantity --bypass-policy",
    "analyze": "npm run build && npx vite-bundle-visualizer"
  },
  "dependencies": {
    "@itwin/browser-authorization": "^1.0.1",
    "@itwin/imodels-client-management": "^6.0.2",
    "@itwin/imodels-client-authoring": "^6.0.2",
    "@itwin/imodels-access-frontend": "^6.0.2",
    "@itwin/itwins-client": "^1.6.1",
    "@itwin/access-control-client": "^2.0.0",
    "@itwin/appui-abstract": "link:../../../itwinjs-core/ui/appui-abstract",
    "@itwin/web-viewer-react": "^5.0.1",
    "@itwin/editor-frontend": "link:../../../itwinjs-core/editor/frontend",
    "@open-cloud-cad/shared": "workspace:*",
    "@open-cloud-cad/viewer-core": "workspace:*",
    "@open-cloud-cad/web-viewer": "workspace:*",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-dropzone": "^14.2.0",
    "react-router-dom": "^6.20.0",
    "@tanstack/react-query": "^5.0.0"
  },
  "devDependencies": {
    "@itwin/core-bentley": "link:../../../itwinjs-core/core/bentley",
    "@itwin/core-common": "link:../../../itwinjs-core/core/common",
    "@itwin/core-frontend": "link:../../../itwinjs-core/core/frontend",
    "@itwin/core-geometry": "link:../../../itwinjs-core/core/geometry",
    "@itwin/core-i18n": "link:../../../itwinjs-core/core/i18n",
    "@itwin/core-quantity": "link:../../../itwinjs-core/core/quantity",
    "@itwin/ecschema-metadata": "link:../../../itwinjs-core/core/ecschema-metadata",
    "@itwin/ecschema-rpcinterface-common": "link:../../../itwinjs-core/core/ecschema-rpc/common",
    "@itwin/editor-common": "link:../../../itwinjs-core/editor/common",
    "@itwin/eslint-plugin": "^6.0.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.2.0",
    "@itwin/appui-react": "^5.5.0",
    "@itwin/imodel-components-react": "^5.5.0",
    "@itwin/itwinui-icons-react": "^2.9.0",
    "@itwin/itwinui-react": "^3.18.0",
    "@itwin/presentation-common": "link:../../../itwinjs-core/presentation/common",
    "@itwin/presentation-components": "^5.12.0",
    "@itwin/presentation-frontend": "link:../../../itwinjs-core/presentation/frontend",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.31.0",
    "jsdom": "^26.0.0",
    "npm-run-all2": "^7.0.2",
    "@playwright/test": "^1.42.0",
    "typescript": "~5.6.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@tanstack/react-query-devtools": "^5.0.0",
    "sass-embedded": "^1.77.0",
    "@itwin/components-react": "^5.5.0",
    "@itwin/core-react": "^5.5.0",
    "redux": "^5.0.0"
  }
}
