{
  "name": "@open-cloud-cad/web-viewer",
  "version": "1.0.0",
  "description": "Web platform viewer for Open Cloud CAD",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
