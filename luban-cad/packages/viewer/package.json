{
  "name": "@luban-cad/viewer",
  "version": "0.1.0",
  "description": "Viewer host for LubanCAD: iTwin.js startup sequence, RPC wiring, AccuSnap lifecycle",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" 1>&2",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "dependencies": {
    "@itwin/appui-abstract": "link:../../../itwinjs-core/ui/appui-abstract",
    "@itwin/core-bentley": "link:../../../itwinjs-core/core/bentley",
    "@itwin/core-common": "link:../../../itwinjs-core/core/common",
    "@itwin/core-frontend": "link:../../../itwinjs-core/core/frontend",
    "@itwin/core-geometry": "link:../../../itwinjs-core/core/geometry",
    "@itwin/editor-frontend": "link:../editor/frontend",
    "@itwin/imodels-access-frontend": "^6.0.2",
    "@itwin/imodels-client-management": "^6.0.2",
    "@luban-cad/shared": "workspace:*"
  },
  "devDependencies": {
    "@itwin/eslint-plugin": "^6.0.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^9.31.0",
    "jsdom": "^26.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "typescript": "~5.6.2",
    "vitest": "^4.1.10"
  }
}
