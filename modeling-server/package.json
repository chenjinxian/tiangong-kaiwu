{
  "name": "@luban-cad/modeling-server",
  "version": "1.0.0",
  "description": "LubanCAD modeling backend service - opens/hosts iModels, executes modeling edits, serves render data (RPC + WebSocket IPC)",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:web": "cross-env NODE_ENV=development tsx watch src/main.ts",
    "lint": "eslint \"src/**/*.ts\" 1>&2",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@itwin/core-backend": "link:../itwinjs-core/core/backend",
    "@itwin/core-bentley": "link:../itwinjs-core/core/bentley",
    "@itwin/core-common": "link:../itwinjs-core/core/common",
    "@itwin/core-geometry": "link:../itwinjs-core/core/geometry",
    "@itwin/editor-backend": "link:../itwinjs-core/editor/backend",
    "@itwin/editor-common": "link:../itwinjs-core/editor/common",
    "@itwin/imodels-access-backend": "^6.0.2",
    "@itwin/imodels-client-authoring": "^6.0.2",
    "@itwin/itwins-client": "^1.6.1",
    "@itwin/object-storage-azure": "^3.0.4",
    "@azure/storage-blob": "^12.28.0",
    "@luban-cad/shared": "link:../luban-cad/packages/shared",
    "cors": "^2.8.5",
    "express": "^4.22.1",
    "express-ws": "^5.0.2",
    "ws": "^7.5.11",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@itwin/eslint-plugin": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.20",
    "@types/express-ws": "^3.0.3",
    "@types/node": "~20.17.0",
    "@types/passport": "^1.0.16",
    "@types/passport-jwt": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/ws": "^7.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.31.0",
    "tsx": "~4.22.0",
    "typescript": "~5.6.2",
    "vitest": "^4.1.10",
    "cookie-parser": "~1.4.7",
    "helmet": "~8.1.0",
    "@types/cookie-parser": "~1.4.10"
  }
}
