{
  "name": "@luban-cad/webhook-agent",
  "version": "1.0.0",
  "description": "Webhook agent for LubanCAD - receives and processes iTwin Platform webhooks",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "ws": "^7.5.11",
    "express": "^4.22.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "@itwin/core-backend": "link:../itwinjs-core/core/backend",
    "@itwin/core-bentley": "link:../itwinjs-core/core/bentley",
    "@itwin/core-common": "link:../itwinjs-core/core/common",
    "@itwin/core-geometry": "link:../itwinjs-core/core/geometry",
    "@itwin/ecschema-metadata": "link:../itwinjs-core/core/ecschema-metadata",
    "@itwin/object-storage-azure": "^3.0.4",
    "@itwin/object-storage-core": "^3.0.4",
    "@azure/storage-blob": "^12.28.0"
  },
  "devDependencies": {
    "@itwin/eslint-plugin": "^6.0.0",
    "@types/node": "~20.17.0",
    "@types/ws": "^7.0.0",
    "@types/express": "^4.17.20",
    "@types/cors": "^2.8.17",
    "eslint": "^9.31.0",
    "tsx": "~4.22.0",
    "typescript": "~5.6.2"
  }
}
