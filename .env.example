# tiangong-kaiwu 本地/内网部署环境变量（唯一事实源）
# 首次使用：powershell -File scripts/generate-env.ps1  生成本 .env 的随机密钥版
# 规则：密钥项必填无默认；URL/端口项有 dev 默认，内网部署按需覆盖。

# ---------- 通用 ----------
# IMODELHUB_ADMIN_EMAIL=admin@example.com        # HUB 管理账号（需与 imodelhub-services 侧一致）
# IMODELHUB_ADMIN_PASSWORD=                      # >=12 位，generate-env 生成

# ---------- modeling-server (宿主 5401 / 容器内 4001) ----------
# BACKEND_API_KEY=                               # 32+ 位随机，验 webhook-agent 入站
# CSRF_SECRET=                                   # 32+ 位随机
# PORT=5401
# IMODELHUB_URL=http://localhost:5400
# FRONTEND_URL=http://localhost:5300
# 注：iModel 初始化重试链路为 前端 → modeling-server → imodelhub-services /imodels/:id/baselinefile/requeue，
#     不再经过 webhook-agent；原 WEBAGENT_URL / WEBAGENT_API_KEY 已随 MS→WA 边删除（2026-09 T1.5）。
# AZURITE_ACCOUNT_NAME=devstoreaccount1
# AZURITE_HOST=127.0.0.1:10500
# AZURE_BLOB_ENDPOINT=http://azurite:10000/devstoreaccount1     # HUB 侧 blob 端点（容器内端口不变；宿主发布见 compose 10500）（=根 compose imodelhub 服务同值）；MS 预签名 URL 主机改写层的识别基准
# AZURE_BLOB_PUBLIC_HOST=127.0.0.1:10500                        # 宿主 MS 可达的 blob 主机；与上一键同设才激活改写（任一缺省恒不改写）
# BRIEFCASE_CACHE_LOCATION=./briefcase-cache

# ---------- webhook-agent (宿主 5402 / 容器内 4002) ----------
# BACKEND_API_KEY 同时被 webhook-agent 用于调 modeling-server（同一值，只写一次）
# AZURITE_ACCOUNT_KEY=                           # Azurite 账号密钥（本地 Azurite 为 well-known key，内网真实存储换真值）
# WEBHOOK_SECRET=                                # 32+ 位随机，HMAC 验签（需与 imodelhub-services webhook 订阅一致）
# IMODELHUB_API_KEY=                             # 32+ 位随机，WA→HUB 出站；同时被 modeling-server 用于调 HUB requeue（同一值，只写一次）
#                                               # ↳ 根 docker-compose.yml 将本值映射注入 imodelhub 容器的 AGENT_API_KEY
#                                               #   （HUB baseline 家族 X-API-Key guard 与应用侧同钥；缺失时 HUB 拒启——Task 2 fail-fast）
# MODELING_SERVER_URL=http://localhost:5401

# ---------- 可选 ----------
# LOG_LEVEL=info
# RECOVERY_CHECK_INTERVAL_MINUTES=5
# RECOVERY_MAX_PER_CHECK=10
# DISABLE_AUTOMATIC_RECOVERY=false

# ---------- 根 docker-compose.yml 专属 ----------
# AUTH_JWT_SECRET=                               # 32+ 位随机，HUB JWT 签名密钥（generate-env 生成）；覆盖镜像内置测试值 secret，缺失 compose 拒启
# AUTH_REFRESH_SECRET=                           # 32+ 位随机，HUB refresh token 签名（generate-env 生成）；缺失 compose 拒启（2026-10-12 审计 P1#2）
# AUTH_FORGOT_SECRET=                            # 32+ 位随机，HUB 忘记密码令牌签名（同上）
# AUTH_CONFIRM_EMAIL_SECRET=                     # 32+ 位随机，HUB 邮箱确认令牌签名（同上）
# HUB_ALLOWED_ORIGINS=http://localhost:5300,http://localhost:5301,http://localhost:5310   # HUB CORS 白名单（逗号分隔；默认 vite dev :5300 + nginx 单入口 :5301 + web-next dev :5310）
# HUB_DATABASE_USERNAME=root                     # postgres/imodelhub 共用（还有 _PASSWORD/_NAME，默认 root/secret/api）
# IMODELHUB_ADMIN_PASSWORD                       # 同「通用」段同名键：compose 注入 HUB 的 SEED_ADMIN_PASSWORD（缺失 compose 拒启）
# MS_UPSTREAM=host.docker.internal:5401          # nginx 的 modeling-server 上游；容器形态（--profile container）改 modeling-server:4001
# BFF_UPSTREAM=host.docker.internal:5401         # nginx 的 /api 上游（RW1-T3 BFF v1；generate-env 生成，缺省与 compose 同值）；缺省直达宿主 MS；启用 BFF 改 luban-bff:5403；容器形态（BFF 未启用）保持 host.docker.internal:5401 或改 modeling-server:4001
# WA_MODELING_SERVER_URL=http://host.docker.internal:5401   # webhook-agent 容器访问宿主 MS；容器形态改 http://modeling-server:4001
# THROTTLER_SHORT_LIMIT=600                      # HUB 短窗限流桶（按 IP；官方缺省 200/min，compose 插值缺省=官方值零漂移）
# THROTTLER_LONG_LIMIT=6000                      # HUB 长窗限流桶（按 IP；官方缺省 2000/h）
#                                                # ↳ 本地 e2e 建议 600/6000（2026-10-22 M5-T5 实测：全套件 + MS wsAuth 每条 WS
#                                                #   连接打 HUB /auth/me 校验同走 127.0.0.1 一只桶，200/min 打满后 429 →
#                                                #   MS 把非 ok 一律当 invalid 缓存 60s → 编辑器 WS 401 拒绝「正在打开文档…」永挂；
#                                                #   调参后全套件 13.5min → 1.6min）。内网/生产部署勿放大——限流是安全面。

# ---------- 宿主端口一览（2026-10-20 重排；避开 itwinjs-core 3000/3001/5000/8080） ----------
# web dev :5300 | nginx 入口 :5301 | HUB :5400 | MS :5401 | WA :5402 | BFF 内部 :5403
# Azurite 宿主 :10500-10502（容器内 10000-10002）| Postgres 宿主 :55432 | Redis :56379 | Maildev :11025/:11080
# 完整登记见 docs/PORTS.md（含 .env 键名与内部/宿主端口对照）
