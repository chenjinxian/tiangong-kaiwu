# tiangong-kaiwu 本地/内网部署环境变量（唯一事实源）
# 首次使用：powershell -File scripts/generate-env.ps1  生成本 .env 的随机密钥版
# 规则：密钥项必填无默认；URL/端口项有 dev 默认，内网部署按需覆盖。

# ---------- 通用 ----------
# IMODELHUB_ADMIN_EMAIL=admin@example.com        # HUB 管理账号（需与 imodelhub-services 侧一致）
# IMODELHUB_ADMIN_PASSWORD=                      # >=12 位，generate-env 生成

# ---------- modeling-server (宿主 5401 / 容器内 4001) ----------
# BACKEND_API_KEY=                               # 32+ 位随机，验 webhook-agent 入站
# CSRF_SECRET=                                   # 32+ 位随机
# PORT=5401
# IMODELHUB_URL=http://localhost:5400
# FRONTEND_URL=http://localhost:5300
# 注：iModel 初始化重试链路为 前端 → modeling-server → imodelhub-services /imodels/:id/baselinefile/requeue，
#     不再经过 webhook-agent；原 WEBAGENT_URL / WEBAGENT_API_KEY 已随 MS→WA 边删除（2026-09 T1.5）。
# AZURITE_ACCOUNT_NAME=devstoreaccount1
# AZURITE_HOST=127.0.0.1:10500
# AZURE_BLOB_ENDPOINT=http://azurite:10000/devstoreaccount1     # HUB 侧 blob 端点（容器内端口不变；宿主发布见 compose 10500）（=根 compose imodelhub 服务同值）；MS 预签名 URL 主机改写层的识别基准
# AZURE_BLOB_PUBLIC_HOST=127.0.0.1:10500                        # 宿主 MS 可达的 blob 主机；与上一键同设才激活改写（任一缺省恒不改写）
# BRIEFCASE_CACHE_LOCATION=./briefcase-cache
# LUBAN_RPC_RATE_LIMIT_MAX=100                  # RPC 每 IP/窗口最大请求数（缺省 100；仅全量 e2e/压测临时覆盖，运行后恢复）
# LUBAN_RPC_RATE_LIMIT_WINDOW_MS=900000         # 限流窗口毫秒（缺省 15min）；MS 启动日志打印 resolved 配置
# SESSION_TOKEN_VIA_QUERY=deny                   # G1 B5a（MS + BFF）：deny（缺省）拒绝 ?token=；allow 仅作已登记回滚窗口（EXCEPTIONS X-18），不得用于发布
# AUTH_TOKEN_CACHE_TTL_MS=0                      # G1 B1.2c（MS + BFF）：正 token 缓存 TTL；0（缺省）每次回源，logout/撤销下一请求生效；>0 为性能选项，会重新打开 ≤TTL 撤销窗口；负结果永不缓存
# WS_AUTH_REVALIDATE_INTERVAL_MS=30000           # G1 B1.2b/B1.2c：既有 WS 每连接 Hub 会话复验间隔（ms，>=1000，缺省 30s；既有 socket 最大撤销延迟见 EXCEPTIONS X-20）；探针鉴权见下方 IMODELHUB_AUTH_MODE
# ---------- G1 B2/B3 OBO 决策传输与读强制（MS 侧，默认 off） ----------
# AUTH_OBO_MODE=shadow                           # 仅 shadow；off 缺省。要求 Hub 同批开启 AUTH_OBO_ENABLED=shadow、非空 AUTH_OBO_DENY_SERVICE_USER_IDS（生产）并保持 AUTHZ_ENFORCE=off
# AUTH_OBO_SERVICE_NAME=modeling-server          # 必须与 Hub AUTH_OBO_SERVICE_NAME 完全一致；service-token 模式下还必须等于 IMODELHUB_SERVICE_CLIENT_ID
# AUTH_OBO_HUB_URL=http://127.0.0.1:5400         # 可选；缺省复用 IMODELHUB_URL
# AUTH_OBO_HTTP_TIMEOUT_MS=2000                  # 单次 shadow Hub 调用上限；失败仅记录，legacy 路径继续（B3.1c enforce 下改为 fail closed）
# AUTH_OBO_RATE_LIMIT_COOLDOWN_MS=30000          # 429 后 shadow 冷却，避免放大 Hub 压力
# ---------- G1 B3.1c：MS 读强制（默认 off；enforce 必须与上方 shadow 传输同开） ----------
# off（缺省）保持 legacy/shadow 读行为。enforce 要求 AUTH_OBO_MODE=shadow + AUTH_OBO_SERVICE_NAME，否则启动失败。
# enforce：download/open rw=doc.read+briefcase.write、readonly/version-open/FeatureOp 读=doc.read；
# 无 session/handle/Hub 决策不可用 → fail closed（AuthorizationDenied 403 / AuthorizationUnavailable 503），不回退 legacy。
# 回滚=改回 off；无数据/schema 迁移。
# AUTH_B3_READ_MODE=enforce                      # off | enforce
# ---------- G1 B3.1d：MS 写强制（默认 off；enforce 必须与上方 shadow 传输 + direct-edit guard enforce 同开） ----------
# off（缺省）保持 legacy 写路径逐字不变（零新增 await/调用）。enforce 要求
# AUTH_OBO_MODE=shadow + AUTH_OBO_SERVICE_NAME + DIRECT_EDIT_GUARD_MODE=enforce，否则启动失败。
# enforce：FeatureOp 写/预览/PartStudio/rename/acquireWriteLease/直改/save/pull=doc.write，
# push=doc.write+changeset.push（单次 AND 决策），abandon=briefcase.write，release lease 不强制；
# 决策先于 service init/EditTxn/db save-push-pull-abandon/lease 获取；deny/unavailable →
# AuthorizationDenied 403 / AuthorizationUnavailable 503，不回退共享 key/JWT/legacy。
# 写决策缓存强制 ≤5s（读仍 ≤30s）；建议先开 AUTH_B3_READ_MODE=enforce（write-only 启动告警）。
# 回滚=改回 off；无数据/schema 迁移。B4 Write 未激活：当前写=Manage，显式 Edit/Write grant 预期 deny。
# AUTH_B3_WRITE_MODE=enforce                     # off | enforce

# ---------- G1 B6 P2：MS → Hub 内部路由服务身份（session-status + OBO shadow） ----------
# 缺省=legacy（保留 X-API-Key + pinned X-Service-Name；MS 启动会打印 DEPRECATED 告警）。
# service-token 为显式 opt-in；token 获取失败/401/403 不会回落到共享 key。
# 数据面（官方 IModelsClient + 服务账号 JWT + X-API-Key、baseline requeue、version open）不受本组变量影响。
# IMODELHUB_AUTH_MODE=service-token              # service-token | legacy-api-key；未设置=legacy（弃用告警）。出现下方任一 service-client 配置时必须显式设 service-token
# IMODELHUB_SERVICE_CLIENT_ID=modeling-server    # Hub service_clients 注册名（签名 sub）；必须等于 Hub AUTH_OBO_SERVICE_NAME。scopes：session.status；AUTH_OBO_MODE=shadow 时再加 auth.delegation,auth.obo,authz.decide
# IMODELHUB_SERVICE_CLIENT_SECRET=               # 16–512 位，来自密钥库/stdin（不落盘、不打印）；与 Hub CLI provision 的 secret 同值
# IMODELHUB_SERVICE_TOKEN_URL=http://127.0.0.1:5400/auth/token/service   # 可选；缺省 <IMODELHUB_URL>/auth/token/service
# IMODELHUB_SERVICE_TOKEN_AUDIENCE=luban-hub:internal                    # 可选；设置后严格校验 JWT 与响应的 aud
# IMODELHUB_SERVICE_TOKEN_REFRESH_SKEW_SECONDS=60 # 0..300；缓存到 exp-skew 后重新签发
# IMODELHUB_SERVICE_TOKEN_TIMEOUT_MS=10000        # 1000..120000
# IMODELHUB_SERVICE_TOKEN_RETRIES=2               # 0..5；仅网络/429/5xx 有界重试；401/403/404 不重试

# ---------- G1 B6 P4a：数据面服务身份（MS / WA；默认 legacy，显式 opt-in） ----------
# legacy（缺省）完全不发 service token；service-token 只对 Hub P3 已启用且本服务 pinned 的官方数据面路由注入，
# token 获取失败/401/403 不回落共享 key。MS 复用上方 IMODELHUB_SERVICE_CLIENT_ID/SECRET 与 token 参数
# （仅需 provision 8 个非 baseline scope——changesets/briefcases/checkpoints read+write、locks read、namedversions read；baseline 仅 webhook-agent pinned，MS 不申请不注入）。
# IMODELHUB_DATA_PLANE_AUTH_MODE=service-token   # MS；legacy | service-token，默认 legacy
# WA 专用（默认名 webhook-agent，必须匹配 Hub WEBHOOK_AGENT_SERVICE_NAME；scopes: data.baseline.read/write）：
# WEBHOOK_AGENT_DATA_PLANE_AUTH_MODE=service-token   # legacy | service-token，默认 legacy
# WEBHOOK_AGENT_SERVICE_CLIENT_ID=webhook-agent
# WEBHOOK_AGENT_SERVICE_CLIENT_SECRET=           # 16–512 位，仅环境/密钥库
# WEBHOOK_AGENT_SERVICE_TOKEN_URL=http://127.0.0.1:5400/auth/token/service   # 可选
# WEBHOOK_AGENT_SERVICE_TOKEN_AUDIENCE=luban-hub:internal                    # 可选
# checkpoint-worker 使用独立变量：CHECKPOINT_WORKER_HUB_DATA_PLANE_AUTH_MODE=legacy|service-token（默认 legacy），
# 复用 CHECKPOINT_WORKER_HUB_SERVICE_CLIENT_ID/SECRET/TOKEN_*；scopes: data.changesets.read/data.briefcases.read/data.checkpoints.read。

# ---------- webhook-agent (宿主 5402 / 容器内 4002) ----------
# BACKEND_API_KEY 同时被 webhook-agent 用于调 modeling-server（同一值，只写一次）
# AZURITE_ACCOUNT_KEY=                           # Azurite 账号密钥（本地 Azurite 为 well-known key，内网真实存储换真值）
# WEBHOOK_SECRET=                                # 32+ 位随机，HMAC 验签（需与 imodelhub-services webhook 订阅一致）
# IMODELHUB_API_KEY=                             # 32+ 位随机，WA→HUB 出站；同时被 modeling-server 用于调 HUB requeue（同一值，只写一次）
#                                               # ↳ 根 docker-compose.yml 将本值映射注入 imodelhub 容器的 AGENT_API_KEY
#                                               #   （HUB baseline 家族 X-API-Key guard 与应用侧同钥；缺失时 HUB 拒启——Task 2 fail-fast）
# MODELING_SERVER_URL=http://localhost:5401

# ---------- 可选 ----------
# LOG_LEVEL=info
# RECOVERY_CHECK_INTERVAL_MINUTES=5
# RECOVERY_MAX_PER_CHECK=10
# DISABLE_AUTOMATIC_RECOVERY=false

# ---------- 根 docker-compose.yml 专属 ----------
# AUTH_JWT_SECRET=                               # 32+ 位随机，HUB JWT 签名密钥（generate-env 生成）；覆盖镜像内置测试值 secret，缺失 compose 拒启
# AUTH_REFRESH_SECRET=                           # 32+ 位随机，HUB refresh token 签名（generate-env 生成）；缺失 compose 拒启（2026-10-12 审计 P1#2）
# AUTH_FORGOT_SECRET=                            # 32+ 位随机，HUB 忘记密码令牌签名（同上）
# AUTH_CONFIRM_EMAIL_SECRET=                     # 32+ 位随机，HUB 邮箱确认令牌签名（同上）
# HUB_ALLOWED_ORIGINS=http://localhost:5300,http://localhost:5301   # HUB CORS 白名单（逗号分隔；默认 vite dev :5300 + nginx 单入口 :5301）
# HUB_DATABASE_USERNAME=root                     # postgres/imodelhub 共用（还有 _PASSWORD/_NAME，默认 root/secret/api）
# IMODELHUB_ADMIN_PASSWORD                       # 同「通用」段同名键：compose 注入 HUB 的 SEED_ADMIN_PASSWORD（缺失 compose 拒启）
# MS_UPSTREAM=host.docker.internal:5401          # nginx 的 modeling-server 上游；容器形态（--profile container）改 modeling-server:4001
# BFF_UPSTREAM=host.docker.internal:5401         # nginx 的 /api 上游（RW1-T3 BFF v1；generate-env 生成，缺省与 compose 同值）；缺省直达宿主 MS；启用 BFF 改 luban-bff:5403；容器形态（BFF 未启用）保持 host.docker.internal:5401 或改 modeling-server:4001
# BFF_AUTH_TOKEN_CACHE_TTL_MS=0                 # G1 B1.2c：compose 注入 BFF 的 AUTH_TOKEN_CACHE_TTL_MS；0（缺省）禁用正缓存，>0 为性能选项（重新打开 ≤TTL 撤销窗口）
# WA_MODELING_SERVER_URL=http://host.docker.internal:5401   # webhook-agent 容器访问宿主 MS；容器形态改 http://modeling-server:4001
# THROTTLER_SHORT_LIMIT=600                      # HUB 短窗限流桶（按 IP；官方缺省 200/min，compose 插值缺省=官方值零漂移）
# THROTTLER_LONG_LIMIT=6000                      # HUB 长窗限流桶（按 IP；官方缺省 2000/h）
#                                                # ↳ 本地 e2e 建议 600/6000（2026-10-22 M5-T5 实测：全套件 + MS wsAuth 每条 WS
#                                                #   连接打 HUB /auth/me 校验同走 127.0.0.1 一只桶，200/min 打满后 429 →
#                                                #   当时 MS 把非 ok 当 invalid 缓存 60s（B1.2c 起负结果永不缓存、正缓存默认 0）→ 编辑器 WS 401 拒绝「正在打开文档…」永挂；
#                                                #   调参后全套件 13.5min → 1.6min）。内网/生产部署勿放大——限流是安全面。

# ---------- 宿主端口一览（2026-10-20 重排；避开 itwinjs-core 3000/3001/5000/8080） ----------
# web dev :5300 | nginx 入口 :5301 | HUB :5400 | MS :5401 | WA :5402 | BFF 内部 :5403
# Azurite 宿主 :10500-10502（容器内 10000-10002）| Postgres 宿主 :55432 | Redis :56379 | Maildev :11025/:11080
# 完整登记见 docs/PORTS.md（含 .env 键名与内部/宿主端口对照）
