# Open Cloud CAD Backend Configuration
# Copy this file to .env and modify values for your deployment
#
# This configuration is for imodelhub-services mode only (local/private iModel Hub)
#
# Required Services:
# - imodelhub-services (default: http://localhost:4000)
# - azurite (Azure Blob Storage emulator, default: http://localhost:10000)

# =============================================================================
# Server Configuration
# =============================================================================

# Server port (default: 4001)
PORT=4001

# Frontend URL for CORS (default: http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# =============================================================================
# imodelhub-services Configuration
# =============================================================================

# Base URL for imodelhub-services API (default: http://localhost:4000)
IMODELHUB_URL=http://localhost:4000

# =============================================================================
# Azurite (Azure Blob Storage Emulator) Configuration
# =============================================================================

# Azurite base URL (default: http://localhost:10000)
AZURITE_URL=http://localhost:10000

# Default azurite account name
AZURITE_ACCOUNT_NAME=devstoreaccount1

# Default azurite account key
# Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
AZURITE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==

# =============================================================================
# iModel Host Configuration
# =============================================================================

# Cache directory for briefcase files (default: ./briefcase-cache)
IMJS_BRIEFCASE_CACHE_LOCATION=./briefcase-cache

# =============================================================================
# Webhook Configuration
# =============================================================================

# Webhook secret for signature validation (required for webhook endpoints)
WEBHOOK_SECRET=your-webhook-secret

# =============================================================================
# Optional: Web-Agent Configuration
# =============================================================================

# Web-Agent URL for forwarded events (default: http://localhost:4002)
WEB_AGENT_URL=http://localhost:4002

# =============================================================================
# Examples for Different Environments
# =============================================================================

# --- Local Development ---
# PORT=4001
# FRONTEND_URL=http://localhost:3000
# IMODELHUB_URL=http://localhost:4000
# AZURITE_URL=http://localhost:10000
# WEBHOOK_SECRET=local-dev-secret

# --- Enterprise On-Premise ---
# PORT=4001
# FRONTEND_URL=https://cad.company.internal
# IMODELHUB_URL=https://imodelhub.company.internal
# AZURITE_URL=https://storage.company.internal
# WEBHOOK_SECRET=enterprise-secret
