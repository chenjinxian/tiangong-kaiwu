# Open Cloud CAD Frontend Environment Variables
#
# Copy this file to .env and update values for your environment
# DO NOT commit .env file to git (it may contain secrets)
#
# Quick Setup:
#   cp .env.example .env
#
# Required Services:
# - Backend API (default: http://localhost:4001)
# - imodelhub-services (default: http://localhost:4000)
# - azurite (Azure Blob Storage emulator, default: http://localhost:10000)

# =============================================================================
# Required Configuration
# =============================================================================

# imodelhub-services API URL
# This is REQUIRED for authentication and iModel management
VITE_IMODELHUB_URL=http://localhost:4000

# Backend API URL (Open Cloud CAD Backend)
VITE_API_URL=http://localhost:4001

# =============================================================================
# Optional Configuration
# =============================================================================

# WebSocket URL (defaults to ws://localhost:4001/ws)
# VITE_WS_URL=ws://localhost:4001/ws

# Debug logging
# VITE_DEBUG=true
