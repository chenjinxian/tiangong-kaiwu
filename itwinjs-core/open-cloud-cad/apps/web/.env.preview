# Preview mode environment (vite preview)
# Use empty values for API URLs to leverage Vite proxy

# Empty API URL means use relative paths (Vite proxy will handle them)
VITE_API_URL=
VITE_IMODELHUB_URL=

# Azurite Storage URL (direct connection is fine, it's blob storage)
VITE_AZURITE_URL=http://localhost:10000
VITE_AZURITE_ACCOUNT_NAME=devstoreaccount1
