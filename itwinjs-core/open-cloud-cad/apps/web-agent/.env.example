# Webhook Agent Configuration
# Pure Webhook Receiver - No WebSocket
#
# Copy this file to .env and update values for your environment
# DO NOT commit .env file to git (it may contain secrets)
#
# Quick Setup:
#   cp .env.example .env
#
# IMPORTANT: WEBHOOK_SECRET must match WEBHOOK_SIGNING_SECRET in imodelhub-services/.env

# =============================================================================
# Required Configuration
# =============================================================================

# Webhook secret from iTwin Platform for signature validation
# This MUST match the WEBHOOK_SIGNING_SECRET in imodelhub-services/.env
WEBHOOK_SECRET=your-webhook-signing-secret-change-in-production

# =============================================================================
# Optional Configuration
# =============================================================================

# Webhook ID for activation (optional)
WEBHOOK_ID=

# Server port (default: 4002)
PORT=4002

# Backend API URL for event forwarding
BACKEND_URL=http://localhost:4001

# API key for backend authentication (optional)
BACKEND_API_KEY=

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Debug logging
DEBUG=true

# =============================================================================
# Baseline File Generation Configuration
# =============================================================================

# Azurite Blob Storage (for local development)
BLOB_STORAGE_URL=http://127.0.0.1:10000/devstoreaccount1
BLOB_ACCOUNT_NAME=devstoreaccount1
BLOB_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
BLOB_CONTAINER_NAME=imodel-baselines

# iModelHub Services API
IMODELHUB_API_URL=http://localhost:4000
IMODELHUB_API_KEY=

# =============================================================================
# Recovery Checker Configuration
# =============================================================================

# Check interval in minutes (default: 5)
RECOVERY_CHECK_INTERVAL_MINUTES=5

# Maximum number of iModels to process per check (default: 10)
RECOVERY_MAX_PER_CHECK=10

# Disable automatic recovery (set to 'true' to disable)
# DISABLE_AUTOMATIC_RECOVERY=false
